# Copy to `.env` for local development: cp env.example .env
# Never commit real secrets; `.env` is gitignored.
DATABASE_URL=postgres://trading:trading@127.0.0.1:5433/trading
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
PORT=8080
HOST=127.0.0.1
ENVIRONMENT=development
RUST_LOG=trading_api=debug,tower_http=info,sqlx=warn
MARKET_TICK_MS=1000
MARKET_SEED=42
INITIAL_CASH=100000.00
FEE_BPS=10
MAX_ORDER_NOTIONAL=1000000.00
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CORS_ORIGINS=
