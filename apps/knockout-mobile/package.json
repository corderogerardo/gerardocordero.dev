    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.85.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
