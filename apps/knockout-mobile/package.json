    "expo": "~56.0.24",
    "expo-background-task": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.5",
    "expo-file-system": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.26",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
